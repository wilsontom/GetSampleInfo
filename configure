#!/bin/sh

set -eu

if [ -z "${THERMO_RAWFILEREADER_HOME:-}" ]; then
  echo "configure: THERMO_RAWFILEREADER_HOME is not set; skipping RawFileReader compilation." >&2
  exit 0
fi

if ! command -v mcs >/dev/null 2>&1; then
  echo "configure: THERMO_RAWFILEREADER_HOME is set but 'mcs' is not available." >&2
  exit 1
fi

echo "configure: compiling RawFileReader helpers from THERMO_RAWFILEREADER_HOME=${THERMO_RAWFILEREADER_HOME}" >&2
bash ./inst/compile.sh
